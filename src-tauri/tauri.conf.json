{
    "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
    "productName": "Ling Canvas",
    "version": "2.0.10",
    "identifier": "com.lingcanvas.app",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Ling Canvas",
                "width": 1400,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 700,
                "center": true,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": true,
                "shadow": false
            }
        ],
        "security": {
            "csp": {
                "default-src": [
                    "'self'",
                    "data:",
                    "blob:",
                    "https://api.chatfire.site",
                    "https://*.chatfire.site"
                ],
                "script-src": [
                    "'self'",
                    "'unsafe-inline'",
                    "'unsafe-eval'"
                ],
                "style-src": [
                    "'self'",
                    "'unsafe-inline'",
                    "https://fonts.googleapis.com"
                ],
                "font-src": [
                    "'self'",
                    "data:",
                    "https://fonts.gstatic.com"
                ],
                "img-src": [
                    "'self'",
                    "data:",
                    "blob:",
                    "https:",
                    "http:",
                    "asset:",
                    "http://asset.localhost"
                ],
                "connect-src": [
                    "'self'",
                    "blob:",
                    "data:",
                    "https://api.chatfire.site",
                    "https://*.chatfire.site",
                    "https://linkapi.ai",
                    "https://linkapi.pro",
                    "https://api.firemux.com",
                    "wss:",
                    "ws:"
                ],
                "media-src": [
                    "'self'",
                    "blob:",
                    "https:",
                    "http:"
                ],
                "worker-src": [
                    "'self'",
                    "blob:"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installMode": "currentUser",
                "languages": ["SimpChinese"],
                "installerIcon": "icons/icon.ico",
                "uninstallerIcon": "icons/icon.ico",
                "installerHooks": "installer-hooks.nsh",
                "template": "nsis/installer.nsi"
            }
        }
    }
}
